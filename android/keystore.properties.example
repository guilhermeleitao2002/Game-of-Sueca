# Copy to keystore.properties (which is gitignored) after creating a keystore.
# Paths are absolute, or relative to this android/ directory.
#
#   keytool -genkeypair -v -keystore sueca-release.jks -alias sueca \
#           -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=sueca-release.jks
storePassword=CHANGE_ME
keyAlias=sueca
keyPassword=CHANGE_ME
